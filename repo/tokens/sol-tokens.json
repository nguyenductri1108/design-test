{
  "$meta": {
    "name": "Sol Design System",
    "version": "1.0.0",
    "mode": "dark-only",
    "note": "Token nguồn cho web/React Native/Tailwind. Tên khớp 1-1 với sol-tokens.css (bỏ tiền tố --sol-)."
  },
  "color": {
    "surface": {
      "bgDeep": "#0A0812",
      "bg": "#130F1F",
      "surface": "#1E1830",
      "surface2": "#241D38",
      "surface3": "#2C2442",
      "nav": "#181227",
      "toast": "#2E2445",
      "track": "#100C1C"
    },
    "ink": {
      "ink": "#F4F1FB",
      "soft": "#E4DFF2",
      "mute": "#A79DC0",
      "dim": "#8C82A8",
      "faint": "#6E6690",
      "disabled": "#5B5279"
    },
    "brand": {
      "violet": "#7C5CFF",
      "violetDeep": "#5B3FD6",
      "violetPress": "#5837C9",
      "violetTint": "rgba(124,92,255,0.16)",
      "violetGlow": "rgba(124,92,255,0.55)",
      "lime": "#C6F24E",
      "limePress": "#96BC2C",
      "limeDeep": "#8FD413",
      "limeInk": "#171227"
    },
    "semantic": {
      "correct": "#3DDC97",
      "correctPress": "#26A972",
      "correctInk": "#0E2A1E",
      "correctTint": "rgba(61,220,151,0.14)",
      "correctLine": "rgba(61,220,151,0.30)",
      "wrong": "#FF5470",
      "wrongPress": "#C93A52",
      "wrongTint": "rgba(255,84,112,0.14)",
      "wrongLine": "rgba(255,84,112,0.30)",
      "streak": "#FFB020"
    },
    "instrument": {
      "keyWhite": "#F6FAEC",
      "keyWhiteOff": "#9E97B4",
      "keyWhiteHit": "#CFC7E4",
      "keyBlack": "#33285C",
      "keyBlackOff": "#191323",
      "keyLabel": "#4E6B14",
      "keyBed": "#0F0B1A",
      "staffPaper": "#F6F3FB",
      "staffLine": "#3A3355",
      "staffInk": "#241D38"
    },
    "border": {
      "default": "rgba(255,255,255,0.07)",
      "strong": "rgba(255,255,255,0.12)"
    }
  },
  "font": {
    "display": "Baloo 2",
    "text": "Be Vietnam Pro",
    "weights": { "display": [500, 600, 700, 800], "text": [400, 500, 600, 700] }
  },
  "text": {
    "displayXl": { "size": 30, "lineHeight": 1.15, "weight": 700, "family": "display" },
    "displayL":  { "size": 25, "lineHeight": 1.2,  "weight": 700, "family": "display" },
    "displayM":  { "size": 22, "lineHeight": 1.25, "weight": 700, "family": "display" },
    "displayS":  { "size": 20, "lineHeight": 1.3,  "weight": 700, "family": "display" },
    "numeric":   { "size": 22, "lineHeight": 1.1,  "weight": 800, "family": "display" },
    "cta":       { "size": 17, "lineHeight": 1.2,  "weight": 800, "family": "display", "letterSpacing": 0.3 },
    "bodyL":     { "size": 15,   "lineHeight": 1.45, "weight": 500, "family": "text" },
    "body":      { "size": 14.5, "lineHeight": 1.35, "weight": 500, "family": "text" },
    "bodyS":     { "size": 13,   "lineHeight": 1.5,  "weight": 400, "family": "text" },
    "caption":   { "size": 12.5, "lineHeight": 1.45, "weight": 400, "family": "text" },
    "micro":     { "size": 11.5, "lineHeight": 1.3,  "weight": 600, "family": "text" },
    "eyebrow":   { "size": 11.5, "lineHeight": 1.3,  "weight": 600, "family": "text", "letterSpacing": 1.2, "transform": "uppercase" }
  },
  "space": { "0.5": 2, "1": 4, "1.5": 6, "2": 8, "2.5": 10, "3": 12, "3.5": 14, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48 },
  "layout": { "gutter": 20, "safeTop": 58, "safeBottom": 34, "minHit": 44, "minLabelSize": 11 },
  "radius": { "xs": 8, "sm": 11, "md": 14, "lg": 16, "xl": 18, "2xl": 24, "3xl": 32, "pill": 999 },
  "elevation": {
    "model": "chunky — mặt đáy đặc, không blur",
    "liftSm": "0 4px 0",
    "liftMd": "0 5px 0",
    "liftLg": "0 6px 0",
    "press": "0 2px 0",
    "pressTranslate": { "liftSm": 2, "liftMd": 3, "liftLg": 4 }
  },
  "motion": {
    "durPress": 0,
    "durFast": 200,
    "durEnter": 350,
    "ease": "cubic-bezier(0.2,0.8,0.2,1)",
    "keyframes": ["solRise", "solPulse", "solBar"]
  },
  "audio": {
    "engine": "WebAudio",
    "voice": { "osc": [["triangle", 1, 1.0], ["sine", 2, 0.32], ["sine", 3, 0.12]], "lowpassHz": 2600 },
    "envelope": { "attack": 0.012, "peak": 0.24, "decayTo": 0.09, "decayAt": 0.18, "release": 0.0008 },
    "timing": { "noteDur": 1.0, "chordDur": 1.4, "intervalGap": 0.55, "progressionGap": 0.85 },
    "feedback": { "correct": [72, 76, 79], "wrong": [61, 60], "gap": 0.1 }
  }
}
